<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dictation. Requested at runtime from the app; the keyboard works without it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only used when the user configures an AI or speech provider themselves. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Optional, granted by the user on a settings screen: the pocket lock without the
      accessibility service. Nothing else uses it.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Lets "open com.some.app" find apps to start. Since Android 11 an app sees only
      the packages it declares an interest in; launchable apps are the interest here,
      and nothing about them is read beyond whether they can be opened.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
    </queries>

    <application
        android:name=".KeyboardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ime.CustomKeyboardIme"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
          Seeing and acting beyond the text field: Back and Home, a pointer for remote
          desktops, reading the post being answered, selecting many items in a feed.
          Off until the user switches it on in the system's accessibility settings, and
          the keyboard works fully without it — each action that needs it says so.
          Bound only by the system, which is what the permission guarantees.
        -->
        <service
            android:name=".io.IoAccessibilityService"
            android:exported="true"
            android:label="@string/access_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/io_access" />
        </service>

        <!--
          The pocket lock from the quick settings shade: starts it with no keyboard open,
          which is when a talking app is running. Does nothing on its own; the lock
          itself lives in the accessibility service above.
        -->
        <service
            android:name=".io.PocketLockTile"
            android:exported="true"
            android:icon="@drawable/ic_pocket_lock"
            android:label="@string/pocket_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          The keyboard with no text field, from the quick settings shade: shortcuts and
          keys sent to the app in front. Works only while this is the current keyboard.
        -->
        <service
            android:name=".ime.KeyboardTile"
            android:exported="true"
            android:icon="@drawable/ic_keyboard_tile"
            android:label="@string/keyboard_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Hands clipboard files to whatever app is being pasted into.

          Needed because our files are ours: an app receiving a paste cannot read a
          path, only a URI it has been granted. Scoped to one directory by
          res/xml/clip_paths.xml, and not exported, so a grant only ever exists for
          the duration of a clip the user themselves created.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clip_paths" />
        </provider>

    </application>

</manifest>
