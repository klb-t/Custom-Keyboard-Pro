[
  {
    "id": "openai",
    "label": "OpenAI",
    "wire": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "modelsPath": "/models",
    "defaultModel": "gpt-4o-mini",
    "docsUrl": "https://platform.openai.com/api-keys",
    "note": "Chat, dictation, pictures, reading aloud and embeddings from one key.",
    "capabilities": {
      "transcribe": {
        "wire": "openai_audio",
        "defaultModel": "whisper-1",
        "models": [
          "whisper-1",
          "gpt-4o-transcribe",
          "gpt-4o-mini-transcribe"
        ]
      },
      "ocr": {
        "wire": "openai",
        "defaultModel": "gpt-4o-mini",
        "notes": "Reads the picture with the same model that writes."
      },
      "image": {
        "call": {
          "path": "/images/generations",
          "auth": "bearer",
          "body": {
            "model": "{{model}}",
            "prompt": "{{prompt}}",
            "n": 1
          },
          "resultPath": "data[0].b64_json"
        },
        "defaultModel": "gpt-image-1",
        "models": [
          "gpt-image-1",
          "dall-e-3"
        ]
      },
      "speech": {
        "call": {
          "path": "/audio/speech",
          "auth": "bearer",
          "body": {
            "model": "{{model}}",
            "input": "{{prompt}}",
            "voice": "alloy"
          },
          "resultPath": ""
        },
        "defaultModel": "gpt-4o-mini-tts"
      },
      "embed": {
        "call": {
          "path": "/embeddings",
          "auth": "bearer",
          "body": {
            "model": "{{model}}",
            "input": "{{prompt}}"
          },
          "resultPath": "data[0].embedding"
        },
        "defaultModel": "text-embedding-3-small"
      },
      "complete": {
        "call": {
          "path": "/chat/completions",
          "auth": "bearer",
          "body": {
            "model": "{{model}}",
            "messages": [
              {
                "role": "user",
                "content": "{{prompt}}"
              }
            ],
            "stream": true,
            "max_tokens": "{{maxTokens}}",
            "temperature": "{{temperature}}",
            "logprobs": true,
            "top_logprobs": 1
          },
          "stream": true,
          "streamTextPath": "choices[0].delta.content",
          "streamDone": "[DONE]",
          "streamLogProbPath": "choices[0].logprobs.content[0].logprob"
        },
        "defaultModel": "gpt-4o-mini",
        "notes": "Streams, so a continuation can be cut where it stops being sure."
      }
    },
    "needsCard": true,
    "privacy": "no_training",
    "strengths": [
      "general",
      "dictation",
      "images",
      "speech",
      "well-known"
    ]
  },
  {
    "id": "anthropic",
