      "handwriting"
    ]
  },
  {
    "id": "gemini",
    "label": "Google Gemini",
    "wire": "gemini",
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "modelsPath": "/models",
    "defaultModel": "gemini-2.5-flash",
    "docsUrl": "https://aistudio.google.com/app/apikey",
    "note": "Chat, pictures and video behind one key, with a free tier.",
    "capabilities": {
      "ocr": {
        "wire": "gemini",
        "defaultModel": "gemini-2.5-flash",
        "notes": "Reads the picture with the same model that writes."
      },
      "image": {
        "call": {
          "path": "/models/{{model}}:predict",
          "auth": "query",
          "authName": "key",
          "body": {
            "instances": [
              {
                "prompt": "{{prompt}}"
              }
            ],
            "parameters": {
              "sampleCount": 1
            }
          },
          "resultPath": "predictions[0].bytesBase64Encoded"
        },
        "defaultModel": "imagen-4.0-generate-001"
      },
      "embed": {
        "call": {
          "path": "/models/{{model}}:embedContent",
          "auth": "query",
          "authName": "key",
          "body": {
            "content": {
              "parts": [
                {
                  "text": "{{prompt}}"
                }
              ]
            }
          },
          "resultPath": "embedding.values"
        },
        "defaultModel": "text-embedding-004"
      }
    },
    "freeTier": true,
    "privacy": "trains_by_default",
    "strengths": [
      "free-tier",
      "multimodal",
      "long-context",
      "video"
    ],
    "signupUrl": "https://aistudio.google.com/app/apikey"
  },
  {
    "id": "mistral",
    "label": "Mistral",
    "wire": "openai",
    "baseUrl": "https://api.mistral.ai/v1",
    "modelsPath": "/models",
    "defaultModel": "mistral-small-latest",
    "docsUrl": "https://console.mistral.ai/api-keys",
    "note": "The only one here with an OCR endpoint built for documents rather than chat.",
    "capabilities": {
      "transcribe": {
        "wire": "openai_audio",
        "defaultModel": "voxtral-mini-latest"
      },
      "ocr": {
        "call": {
          "path": "/ocr",
          "auth": "bearer",
          "body": {
            "model": "{{model}}",
            "document": {
              "type": "image_url",
              "image_url": "data:{{imageMime}};base64,{{imageBase64}}"
            }
          },
          "resultPath": "pages[0].markdown"
        },
        "defaultModel": "mistral-ocr-latest"
      },
      "embed": {
        "call": {
          "path": "/embeddings",
          "auth": "bearer",
          "body": {
            "model": "{{model}}",
            "input": "{{prompt}}"
          },
          "resultPath": "data[0].embedding"
        },
        "defaultModel": "mistral-embed"
      },
      "complete": {
        "call": {
          "path": "/chat/completions",
          "auth": "bearer",
          "body": {
            "model": "{{model}}",
            "messages": [
              {
                "role": "user",
                "content": "{{prompt}}"
              }
            ],
            "stream": true,
            "max_tokens": "{{maxTokens}}",
            "temperature": "{{temperature}}"
          },
          "stream": true,
          "streamTextPath": "choices[0].delta.content",
          "streamDone": "[DONE]"
        },
        "defaultModel": "mistral-small-latest",
        "notes": "Streams, so a continuation can be cut where it stops being sure."
      }
    },
    "freeTier": true,
    "privacy": "no_training",
    "strengths": [
      "european",
      "ocr",
      "dictation",
      "cheap"
    ]
  },
