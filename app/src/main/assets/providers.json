    "docsUrl": "https://console.anthropic.com/settings/keys",
    "note": "Strong at rewriting and at reading messy handwriting.",
    "capabilities": {
      "ocr": {
        "wire": "anthropic",
        "defaultModel": "claude-haiku-4-5-20251001",
        "notes": "Reads the picture with the same model that writes."
      }
    },
    "needsCard": true,
    "privacy": "no_training",
    "strengths": [
